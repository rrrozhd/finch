# copy to .env and fill in
# LLM via Amazon Bedrock: either a Bedrock API key, or AWS access keys
AWS_REGION=us-west-2
BEDROCK_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_SMART=us.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_FAST=us.anthropic.claude-haiku-5-5
DAYTONA_API_KEY=
ARIZE_SPACE_ID=
ARIZE_API_KEY=
# SurrealDB Cloud instance (leave empty to use in-memory for local dev)
SURREAL_URL=
SURREAL_USER=
SURREAL_PASS=
SURREAL_NS=taxagent
SURREAL_DB=demo
